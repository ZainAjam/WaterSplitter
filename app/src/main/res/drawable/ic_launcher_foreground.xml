<?xml version="1.0" encoding="utf-8"?>
<!-- A white water drop whose body is a calculator: display bar on top, 3x2 keypad below (the "=" key is the accent). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- drop -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,21 C54,21 28,45 28,58 A26,26 0 0 0 80,58 C80,45 54,21 54,21 Z" />

    <!-- calculator display -->
    <path
        android:fillColor="#FF01579B"
        android:pathData="M40,40 H68 A2,2 0 0 1 70,42 V48 A2,2 0 0 1 68,50 H40 A2,2 0 0 1 38,48 V42 A2,2 0 0 1 40,40 Z" />

    <!-- keys, row 1 -->
    <path
        android:fillColor="#FF01579B"
        android:pathData="M40,56 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z
                          M52,56 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z
                          M64,56 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z" />

    <!-- keys, row 2 -->
    <path
        android:fillColor="#FF01579B"
        android:pathData="M40,68 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z
                          M52,68 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z" />

    <!-- "=" key -->
    <path
        android:fillColor="#FF29B6F6"
        android:pathData="M64,68 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z" />
</vector>

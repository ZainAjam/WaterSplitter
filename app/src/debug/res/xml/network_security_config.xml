<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: lets the app talk plain HTTP to this computer's local test server (reached with `adb reverse`)
     so the in-app updater can be tested without GitHub. Release builds have no such exception. -->
